#!/usr/bin/env python3
"""exa - en modern ersättare för `ls`.

Listar filer och kataloger med färg, långt format, rutnät och trädvy.
Använder **endast Pythons standardbibliotek** — inga externa beroenden.

Designmål:
- Degradera säkert när metadata inte går att läsa (t.ex. i Termux/Android
  där uid/gid inte alltid går att slå upp till namn).
- Behandla filnamn som otillförlitliga: kontrolltecken (inklusive ANSI-
  escapesekvenser) saneras innan de skrivs till terminalen för att förhindra
  terminal-escape-injektion via manipulerade filnamn.
- Anropa inga externa kommandon (ingen risk för command injection).
"""

from __future__ import annotations

import argparse
import json
import os
import stat as stat_module
import sys
import time
from typing import Any, Callable, Iterable

try:
    import pwd  # endast Unix; uid -> användarnamn
except ImportError:  # pragma: no cover - icke-Unix
    pwd = None  # type: ignore[assignment]

try:
    import grp  # endast Unix; gid -> gruppnamn
except ImportError:  # pragma: no cover - icke-Unix
    grp = None  # type: ignore[assignment]

__version__ = "1.0.1"

PROG = "exa"

# ANSI-färgkoder. Tomma om färg är avstängd.
RESET = "\x1b[0m"
COLORS = {
    "dir": "\x1b[1;34m",       # katalog: fet blå
    "symlink": "\x1b[1;36m",   # symlänk: fet cyan
    "broken": "\x1b[1;31m",    # trasig symlänk: fet röd
    "exec": "\x1b[1;32m",      # körbar fil: fet grön
    "socket": "\x1b[1;35m",    # socket: fet magenta
    "fifo": "\x1b[33m",        # named pipe: gul
    "device": "\x1b[1;33m",    # block-/teckenenhet: fet gul
    "setuid": "\x1b[1;37;41m", # setuid/setgid: vit på röd
    "size": "\x1b[0;32m",      # storlek: grön
    "date": "\x1b[0;34m",      # datum: blå
    "user": "\x1b[0;33m",      # ägare: gul
    "perm_read": "\x1b[0;33m",
    "perm_write": "\x1b[0;31m",
    "perm_exec": "\x1b[0;32m",
}


def _safe(func: Callable[[], Any], default: Any = None) -> Any:
    """Kör func och returnerar default vid vilket fel som helst."""
    try:
        return func()
    except Exception:
        return default


def sanitize_name(name: str) -> str:
    """Ersätter kontrolltecken i ett filnamn med '?'.

    Filnamn är otillförlitlig indata. Ett filnamn som innehåller ANSI-
    escapesekvenser kan annars manipulera terminalen (byta färg, flytta
    markör, m.m.) när det skrivs ut. Vi ersätter alla tecken i C0/C1-
    intervallen samt DEL.
    """
    out = []
    for ch in name:
        code = ord(ch)
        if code < 0x20 or code == 0x7F or 0x80 <= code <= 0x9F:
            out.append("?")
        else:
            out.append(ch)
    return "".join(out)


# ---------------------------------------------------------------------------
# Metadata-insamling
# ---------------------------------------------------------------------------


def uid_name(uid: int) -> str:
    if pwd is not None:
        entry = _safe(lambda: pwd.getpwuid(uid))
        if entry is not None:
            return entry.pw_name
    return str(uid)


def gid_name(gid: int) -> str:
    if grp is not None:
        entry = _safe(lambda: grp.getgrgid(gid))
        if entry is not None:
            return entry.gr_name
    return str(gid)


def mode_to_string(mode: int) -> str:
    """Bygger en `ls`-lik rättighetssträng, t.ex. '-rwxr-xr-x'."""
    if stat_module.S_ISDIR(mode):
        first = "d"
    elif stat_module.S_ISLNK(mode):
        first = "l"
    elif stat_module.S_ISCHR(mode):
        first = "c"
    elif stat_module.S_ISBLK(mode):
        first = "b"
    elif stat_module.S_ISFIFO(mode):
        first = "p"
    elif stat_module.S_ISSOCK(mode):
        first = "s"
    else:
        first = "-"

    perms = ""
    for who, r, w, x in (
        ("u", stat_module.S_IRUSR, stat_module.S_IWUSR, stat_module.S_IXUSR),
        ("g", stat_module.S_IRGRP, stat_module.S_IWGRP, stat_module.S_IXGRP),
        ("o", stat_module.S_IROTH, stat_module.S_IWOTH, stat_module.S_IXOTH),
    ):
        perms += "r" if mode & r else "-"
        perms += "w" if mode & w else "-"
        # Setuid/setgid/sticky-bitar påverkar exec-positionen.
        if who == "u" and mode & stat_module.S_ISUID:
            perms += "s" if mode & x else "S"
        elif who == "g" and mode & stat_module.S_ISGID:
            perms += "s" if mode & x else "S"
        elif who == "o" and mode & stat_module.S_ISVTX:
            perms += "t" if mode & x else "T"
        else:
            perms += "x" if mode & x else "-"
    return first + perms


class Entry:
    """En listad post med förbehandlad metadata."""

    __slots__ = ("name", "path", "st", "lst", "link_target", "error")

    def __init__(self, name: str, path: str) -> None:
        self.name = name
        self.path = path
        self.error: str | None = None
        # lst = lstat (följer ej symlänk), st = stat (följer symlänk).
        self.lst = _safe(lambda: os.lstat(path))
        if self.lst is None:
            self.error = "kunde inte läsa metadata"
            self.st = None
            self.link_target = None
            return
        self.link_target = None
        if stat_module.S_ISLNK(self.lst.st_mode):
            self.link_target = _safe(lambda: os.readlink(path))
            self.st = _safe(lambda: os.stat(path))  # None om trasig länk
        else:
            self.st = self.lst

    @property
    def is_dir(self) -> bool:
        return self.st is not None and stat_module.S_ISDIR(self.st.st_mode)

    @property
    def is_symlink(self) -> bool:
        return self.lst is not None and stat_module.S_ISLNK(self.lst.st_mode)

    @property
    def is_broken_link(self) -> bool:
        return self.is_symlink and self.st is None

    @property
    def is_hidden(self) -> bool:
        return self.name.startswith(".")

    @property
    def size(self) -> int:
        return self.lst.st_size if self.lst is not None else 0

    @property
    def mtime(self) -> float:
        return self.lst.st_mtime if self.lst is not None else 0.0

    @property
    def extension(self) -> str:
        base = self.name.lstrip(".")
        _, dot, ext = base.rpartition(".")
        return ext.lower() if dot else ""

    def color(self) -> str:
        """Returnerar färgnyckel enligt filtyp."""
        if self.is_broken_link:
            return "broken"
        if self.is_symlink:
            return "symlink"
        if self.lst is None:
            return ""
        mode = self.lst.st_mode
        if stat_module.S_ISDIR(mode):
            return "dir"
        if stat_module.S_ISSOCK(mode):
            return "socket"
        if stat_module.S_ISFIFO(mode):
            return "fifo"
        if stat_module.S_ISCHR(mode) or stat_module.S_ISBLK(mode):
            return "device"
        if mode & (stat_module.S_ISUID | stat_module.S_ISGID):
            return "setuid"
        if mode & (stat_module.S_IXUSR | stat_module.S_IXGRP | stat_module.S_IXOTH):
            return "exec"
        return ""


# ---------------------------------------------------------------------------
# Sortering
# ---------------------------------------------------------------------------


SORT_KEYS: dict[str, Callable[[Entry], Any]] = {
    "name": lambda e: e.name.lower(),
    "size": lambda e: e.size,
    "modified": lambda e: e.mtime,
    "type": lambda e: (not e.is_dir, e.name.lower()),
    "extension": lambda e: (e.extension, e.name.lower()),
    "none": lambda e: 0,
}


def sort_entries(entries: list[Entry], key: str, reverse: bool, dirs_first: bool) -> list[Entry]:
    if key in SORT_KEYS and key != "none":
        entries = sorted(entries, key=SORT_KEYS[key], reverse=reverse)
    elif reverse:
        entries = list(reversed(entries))
    if dirs_first:
        entries = sorted(entries, key=lambda e: not e.is_dir)
    return entries


